---
---
<section class="view view-sort hidden" data-view="sort">
  <div class="sort-head">
    <h2>Rank this group</h2>
    <p class="field-note">
      Drag the titles into order, best first. Arrow keys move focus between
      titles. Alt+Arrow (or Ctrl+Arrow) moves the focused title up or down.
    </p>
  </div>
  <ul
    class="sortable-list"
    data-sortable-list
    role="listbox"
    aria-label="Titles to rank, best first"
    aria-orientation="vertical"
  ></ul>
  <p class="visually-hidden" data-sort-group-live aria-live="polite"></p>
  <div class="sort-stats">
    <span class="field-note" data-group-coverage>
      Coverage: 0 / 0 titles compared (0 not compared)
    </span>
    <span class="field-note" data-group-estimate>
      Baseline target: ~0 group sorts (~2 sorts per title).
    </span>
    <span class="field-note">
      You can stop early — fewer sorts means a less certain ranking.
    </span>
  </div>
  <div class="flex flex-wrap gap-2">
    <button class="btn" type="button" data-action="submit-sort">
      Submit ranking
    </button>
    <button class="btn-ghost" type="button" data-action="skip-sort">
      Skip this group
    </button>
    <button
      class="btn-ghost hidden"
      type="button"
      data-action="switch-to-pairwise"
    >
      Switch to pairwise refine
    </button>
  </div>
</section>
