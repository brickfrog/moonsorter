---
---
<section class="view view-compare hidden" data-view="compare">
  <div class="progress-strip">
    <span class="progress-count" data-progress-count>0 of ~0 answered</span>
    <div
      class="progress-track"
      data-progress-track
      role="progressbar"
      aria-label="Comparison progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="progress-fill" data-progress-fill></div>
    </div>
    <span class="progress-ci" data-progress-ci></span>
  </div>

  <div class="arena" data-arena>
    <button class="panel panel-a" type="button" data-choice="A">
      <div class="panel-key">
        <span class="panel-key-badge">A</span>
        <span>or &larr;</span>
      </div>
      <!-- Empty alt: the title beside it already names the option, so the
           poster adds nothing for a screen reader. -->
      <div class="panel-poster" data-choice-poster="A">
        <img class="panel-poster-img hidden" data-choice-cover="A" alt="" loading="lazy" />
        <div class="panel-poster-fallback" data-choice-fallback="A">
          <span class="panel-poster-label">poster</span>
        </div>
      </div>
      <div class="panel-foot">
        <div class="panel-title" data-choice-title="A"></div>
        <div class="panel-meta" data-choice-meta="A"></div>
      </div>
    </button>

    <div class="arena-seam"></div>

    <button class="panel panel-b" type="button" data-choice="B">
      <div class="panel-key">
        <span class="panel-key-badge">B</span>
        <span>or &rarr;</span>
      </div>
      <div class="panel-poster" data-choice-poster="B">
        <img class="panel-poster-img hidden" data-choice-cover="B" alt="" loading="lazy" />
        <div class="panel-poster-fallback" data-choice-fallback="B">
          <span class="panel-poster-label">poster</span>
        </div>
      </div>
      <div class="panel-foot">
        <div class="panel-title" data-choice-title="B"></div>
        <div class="panel-meta" data-choice-meta="B"></div>
      </div>
    </button>
  </div>

  <div class="action-strip">
    <div class="action-strip-left">
      <button class="btn-ghost" type="button" data-action="undo">Undo</button>
      <button class="btn-ghost" type="button" data-choice="TIE">
        Too close to call &middot; space
      </button>
      <button class="btn-ghost" type="button" data-action="redo" disabled>Redo</button>
    </div>
    <div class="action-strip-right">
      <button class="btn" type="button" data-action="finish">Stop and see results</button>
    </div>
  </div>
</section>
