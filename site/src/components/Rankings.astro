---
import TierList from './TierList.astro';

const { title = 'Results' } = Astro.props;
---
<section class="view view-results hidden" data-view="results">
  <div class="results-head">
    <div>
      <h2 class="results-headline" data-results-headline>{title}</h2>
      <p class="results-sub">
        The bar behind each row is the 80% bootstrap interval for that title's rank. Wide bars mean the position is still undecided.
      </p>
    </div>
    <div>
      <div class="results-exports">
        <button class="btn-ghost" type="button" data-action="download-csv">.csv</button>
        <button class="btn-ghost" type="button" data-action="download-results">.json</button>
        <button class="btn-ghost" type="button" data-action="download-session">.session</button>
        <button class="btn hidden" type="button" data-action="upload">Upload to AniList</button>
      </div>
      <p class="status-slot" role="status" aria-live="polite" data-upload-status></p>
    </div>
  </div>

  <div class="results-body">
    <div class="results-main">
      <div class="results-table-actions">
        <button class="btn-ghost" type="button" data-action="select-all">Select all</button>
        <button class="btn-ghost" type="button" data-action="select-none">Select none</button>
        <span class="status-slot" role="status" aria-live="polite" data-selection-status></span>
      </div>

      <!-- Not a <table>: the interval bars need one shared rank axis, which
           only works if every row is the same CSS grid. The ARIA roles put the
           table semantics back for assistive tech. -->
      <div role="table" aria-label="Ranking">
        <div role="rowgroup">
          <div class="rank-row rank-head" role="row">
            <span role="columnheader"><span class="visually-hidden">Select</span></span>
            <span role="columnheader" aria-sort="none">
              <button class="rank-sort" type="button" data-sort="rank">#<span data-sort-indicator="rank"></span></button>
            </span>
            <span role="columnheader" aria-sort="none">
              <button class="rank-sort" type="button" data-sort="title">Title<span data-sort-indicator="title"></span></button>
            </span>
            <span role="columnheader" aria-sort="none">
              <button class="rank-sort" type="button" data-sort="rankCI">Rank interval · 80%<span data-sort-indicator="rankCI"></span></button>
            </span>
            <span class="text-right" role="columnheader" aria-sort="none">
              <button class="rank-sort" type="button" data-sort="newScore">Score<span data-sort-indicator="newScore"></span></button>
            </span>
          </div>
        </div>
        <div role="rowgroup" data-rankings-body></div>
      </div>
    </div>

    <aside class="results-aside">
      <div class="aside-block">
        <p class="eyebrow">Stability</p>
        <div class="stat-row">
          <span class="stat-label">Median CI width</span>
          <span class="stat-value" data-stat-median>—</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Top-K lock-in</span>
          <span class="stat-value" data-stat-topk>—</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Bootstrap samples</span>
          <span class="stat-value" data-stat-samples>—</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Pairs compared</span>
          <span class="stat-value" data-stat-pairs>—</span>
        </div>
        <details class="advanced">
          <summary>Bootstrap settings</summary>
          <div class="advanced-body">
            <label class="inline-field">
              <span class="inline-flex items-center gap-2">Samples <span class="help-dot" title="This value sets the number of bootstrap resamples.">?</span></span>
              <input id="analysis-samples" type="number" min="50" step="50" value="200" />
            </label>
            <label class="inline-field">
              <span class="inline-flex items-center gap-2">Top-K <span class="help-dot" title="This value sets the rank threshold for lock-in.">?</span></span>
              <input id="analysis-topk" type="number" min="1" step="1" value="10" />
            </label>
            <label class="inline-field">
              <span class="inline-flex items-center gap-2">Max iterations <span class="help-dot" title="This value sets the number of MM fit iterations for each sample.">?</span></span>
              <input id="analysis-max-iter" type="number" min="5" step="5" value="40" />
            </label>
            <button class="btn" type="button" data-action="run-analysis">Calculate confidence intervals</button>
            <p class="status-slot" role="status" aria-live="polite" data-analysis-status></p>
          </div>
        </details>
      </div>

      <div class="callout hidden" data-uncertain-callout>
        <p class="eyebrow">Still undecided</p>
        <p class="callout-body" data-uncertain-body></p>
        <div class="uncertain-chips" data-uncertain-chips></div>
        <button class="btn-ghost" type="button" data-action="resume-comparisons">Compare those pairs</button>
      </div>

      <div class="aside-block" data-tier-block>
        <p class="eyebrow">Tiers</p>
        <div data-tier-lines></div>
        <details class="advanced">
          <summary>Tier export</summary>
          <div class="advanced-body">
            <label class="inline-field">
              <span class="inline-flex items-center gap-2">Number of tiers <span class="help-dot" title="This value sets the number of tiers (3-7).">?</span></span>
              <input id="tier-k-value" type="number" min="3" max="7" step="1" value="5" />
            </label>
            <button class="btn-ghost" type="button" data-action="download-tierlist" title="Moonsorter captures the tier list at the current viewport width.">Download tier image</button>
            <p class="status-slot" role="status" aria-live="polite" data-tierlist-status></p>
          </div>
        </details>
      </div>

      <div>
        <button class="btn-ghost" type="button" data-action="restart">Start again</button>
      </div>
    </aside>
  </div>

  <TierList />
</section>
