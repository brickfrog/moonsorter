---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AniList authorization" views={false}>
  <section class="view list-main">
    <span class="eyebrow mb-3">Connecting</span>
    <h1 class="list-headline">Moonsorter connects to AniList</h1>
    <p class="list-lede">
      Moonsorter completes the authorization. Then your browser goes back to the
      main page.
    </p>
    <p class="status-slot" data-auth-status role="status" aria-live="polite"></p>
  </section>

  <script>
    import { consumeAuthResponse } from '../lib/auth';

    const status = document.querySelector('[data-auth-status]');
    const baseUrl = document.body.dataset.baseUrl || '';

    consumeAuthResponse()
      .then((token) => {
        window.location.replace(baseUrl || '/');
      })
      .catch((error) => {
        if (status) {
          status.textContent =
            error instanceof Error ? error.message : 'Authorization failed.';
        }
      });
  </script>
</Layout>
