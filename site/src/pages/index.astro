---
import Layout from '../layouts/Layout.astro';
import Comparison from '../components/Comparison.astro';
import SortGroup from '../components/SortGroup.astro';
import Rankings from '../components/Rankings.astro';
---
<Layout>
  {/*
    The List view starts hidden like every other view: the loading note below
    is what the reader sees until `rank.ts` runs and calls `showView`. Showing
    the list first would promise controls that do nothing until the WASM
    module and the event bindings are in place.
  */}
  <section class="view view-list hidden" data-view="list">
    <div class="list-main">
      <h1 class="list-headline" data-list-headline>
        Your titles. A handful of questions. One ranking you'll actually stand behind.
      </h1>
      <p class="list-lede">
        Moonsorter fits a Plackett–Luce model to your answers and reports how sure it is.
        Import from AniList or a CSV, answer A or B, stop whenever the intervals are tight enough.
      </p>

      <div class="list-actions">
        <button class="btn btn-lg" type="button" data-action="start" disabled>
          Start comparing
        </button>
        <button class="btn-ghost btn-lg" type="button" data-action="connect" data-requires="disconnected">
          Connect AniList
        </button>
        <button class="btn-ghost btn-lg" type="button" data-action="import" data-anilist-only data-requires="connected">
          Import from AniList
        </button>
        <button class="btn-ghost btn-lg" type="button" data-action="csv">
          Upload CSV
        </button>
        <button class="btn-ghost btn-lg" type="button" data-action="import-csv" data-csv-only>
          Import from CSV
        </button>
        <button class="btn-ghost btn-lg" type="button" data-action="demo">
          Use the demo list
        </button>
      </div>

      <p class="status-slot list-status" data-list-status role="status" aria-live="polite"></p>

      <div class="list-table-head">
        <span class="eyebrow">Your list<span data-list-count></span></span>
        <span class="eyebrow">Seed score</span>
      </div>
      <div data-list-body>
        <p class="list-empty">Nothing imported yet.</p>
      </div>
    </div>

    <aside class="list-aside">
      <div class="aside-group">
        <span class="eyebrow">Method</span>
        <label class="method-option">
          <input type="radio" name="rank-method" data-rank-mode="pairwise" checked />
          <span>
            <span class="method-title">Pairwise</span>
            <span class="method-desc">A or B, chosen by expected information gain.</span>
          </span>
        </label>
        <label class="method-option">
          <input type="radio" name="rank-method" data-rank-mode="group" />
          <span>
            <span class="method-title">Group sort</span>
            <span class="method-desc">Drag batches of five into order.</span>
          </span>
        </label>
        <label class="method-option">
          <input type="radio" name="rank-method" data-rank-mode="group-pairwise" />
          <span>
            <span class="method-title">Group, then refine</span>
            <span class="method-desc">Batches first, pairs for the close calls.</span>
          </span>
        </label>
      </div>

      <div class="aside-group">
        <span class="eyebrow">Priors</span>
        {/*
          This checkbox carries the whole rescore-vs-scratch decision now. With
          it on, your current scores seed the model; with it off the ranking
          starts from nothing. The method radios above are unaffected either
          way — they choose the interaction style and nothing else.
        */}
        <label class="check-row">
          <input id="use-score-prior" type="checkbox" checked />
          <span>Use existing scores as priors</span>
        </label>
        <label class="check-row">
          <input id="include-unscored" type="checkbox" />
          <span>Include unscored titles</span>
        </label>
        <label class="check-row">
          <input id="preserve-range" type="checkbox" checked />
          <span>Keep original score range</span>
        </label>
      </div>

      <details class="advanced">
        <summary>Advanced</summary>
        <div class="advanced-body">
          <label class="inline-field" data-anilist-only>
            Media type
            <select id="media-type">
              <option value="ANIME">Anime</option>
              <option value="MANGA">Manga</option>
            </select>
          </label>
          <label class="inline-field" data-anilist-only>
            Import mode
            <select id="import-mode">
              <option value="all">All titles</option>
              <option value="top">Top slice</option>
              <option value="bottom">Bottom slice</option>
              <option value="top-bottom">Top and bottom</option>
            </select>
          </label>
          <label class="inline-field" data-anilist-only>
            Slice size
            <input id="import-count" type="number" min="5" max="100" value="20" />
          </label>
          <label class="inline-field" data-anilist-only>
            Score scale
            <select id="score-format">
              <option value="AUTO">Use the AniList format (automatic)</option>
              <option value="POINT_100">100-point</option>
              <option value="POINT_10_DECIMAL">10-point (decimal)</option>
              <option value="POINT_10">10-point</option>
              <option value="POINT_5">5-point</option>
              <option value="POINT_3">3-point</option>
            </select>
          </label>
          <label class="inline-field" data-anilist-only>
            Aired from
            <input id="filter-aired-from" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            Aired to
            <input id="filter-aired-to" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            Started from
            <input id="filter-started-from" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            Started to
            <input id="filter-started-to" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            Completed from
            <input id="filter-completed-from" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            Completed to
            <input id="filter-completed-to" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            List updated from
            <input id="filter-updated-from" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field" data-anilist-only>
            List updated to
            <input id="filter-updated-to" type="number" min="1900" step="1" />
          </label>
          <label class="inline-field">
            Goal without priors
            <select id="scratch-goal">
              <option value="full">Rank all the titles</option>
              <option value="top-k">Find the top tier quickly</option>
            </select>
          </label>
          <label class="inline-field">
            <span class="inline-flex items-center gap-2">
              Exploration rate
              <span class="help-dot" title="This value sets how frequently Moonsorter asks a random comparison instead of the most informative pair.">?</span>
            </span>
            <input id="exploration-epsilon" type="number" min="0" max="1" step="0.01" value="0.1" />
          </label>
          <label class="inline-field">
            <span class="inline-flex items-center gap-2">
              Uncertainty prior
              <span class="help-dot" title="This value regularizes the uncertainty scores. A high value makes the pair selection less sensitive to sparse data.">?</span>
            </span>
            <input id="uncertainty-prior" type="number" min="0.1" step="0.1" value="1" />
          </label>
          <label data-csv-only>
            CSV file
            <input id="csv-file" type="file" accept=".csv,text/csv" />
          </label>
          <p class="field-note" data-csv-only>
            The file needs a title column and a score column. A media_id column is optional.
          </p>
          <div class="list-actions mt-3" data-anilist-only data-requires="connected">
            <button class="btn-ghost" type="button" data-action="logout">
              Disconnect AniList
            </button>
          </div>
        </div>
      </details>

      <div class="aside-foot">
        <p>Session saves to this browser after every answer.</p>
        <div class="list-actions mt-3">
          <label class="btn-ghost">
            Restore a .session file
            <input
              class="visually-hidden"
              type="file"
              accept=".session,application/json"
              data-session-file
            />
          </label>
          <button class="btn-ghost" type="button" data-action="resume">
            Resume saved session
          </button>
          <button class="btn-ghost" type="button" data-action="clear">
            Clear saved session
          </button>
        </div>
      </div>
    </aside>
  </section>

  <section class="view loading-note" data-loading>
    <p class="field-note">Moonsorter loads the ranking tools.</p>
  </section>

  <Comparison />
  <SortGroup />
  <Rankings />

  <!-- Early finish warning modal -->
  <div
    class="modal-overlay hidden"
    data-early-finish-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="early-finish-title"
    aria-describedby="early-finish-message"
  >
    <div class="modal-card">
      <h3 id="early-finish-title">Results can be unreliable</h3>
      <p class="modal-body" id="early-finish-message" data-early-finish-message>
        <!-- Message will be filled by JS -->
      </p>
      <div class="modal-actions">
        <button class="btn-ghost" type="button" data-action="cancel-finish">
          Continue the comparisons
        </button>
        <button class="btn" type="button" data-action="confirm-finish">
          Show the results
        </button>
      </div>
    </div>
  </div>

  <!-- Start over confirmation modal -->
  <div
    class="modal-overlay hidden"
    data-start-over-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="start-over-title"
    aria-describedby="start-over-message"
  >
    <div class="modal-card">
      <h3 id="start-over-title">Start again?</h3>
      <p class="modal-body" id="start-over-message">
        This action will clear all comparisons and rankings. You cannot undo this action.
      </p>
      <div class="modal-actions">
        <button class="btn-ghost" type="button" data-action="cancel-start-over">
          Cancel
        </button>
        <button class="btn" type="button" data-action="confirm-start-over">
          Start again
        </button>
      </div>
    </div>
  </div>

  <script>
    import '../app/rank.ts';
  </script>
</Layout>
