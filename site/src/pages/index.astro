---
import Layout from '../layouts/Layout.astro';
import Comparison from '../components/Comparison.astro';
import SortGroup from '../components/SortGroup.astro';
import Rankings from '../components/Rankings.astro';
import TierList from '../components/TierList.astro';
---
<Layout>
  <section class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
    <div class="space-y-5">
      <div class="pill">Ranking session</div>
      <h2 class="text-3xl font-display md:text-4xl">
        Rank your list, one pair at a time.
      </h2>
      <p class="text-latte-subtext1">
        Import your list from AniList or from a CSV file. Then answer "A or B?" until you are done. Progress saves automatically.
      </p>
    </div>
    <div class="card space-y-4">
      <h3 class="text-lg font-display">Session controls</h3>
      <p class="text-sm text-latte-subtext1">
        Keep a tab open while you compare. Resume the session at any time.
      </p>
      <div class="flex flex-wrap gap-3">
        <button class="btn-secondary" type="button" data-action="resume">
          Resume saved session
        </button>
        <button class="btn-secondary" type="button" data-action="clear">
          Clear saved session
        </button>
        <label class="btn-secondary session-import">
          Load .session file
          <input
            class="visually-hidden"
            type="file"
            accept=".session,application/json"
            data-session-file
          />
        </label>
      </div>
      <p class="text-xs text-latte-subtext0" data-session-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <section class="card stepper">
    <!-- A stepper is a progress indicator, not a tab set: the buttons control
         which section is shown but there are no tabpanels. `aria-current` on
         the active step conveys position without inventing tab semantics. -->
    <nav class="stepper-track" aria-label="Ranking steps">
      <button class="stepper-item" type="button" data-step-target="connect">
        <span class="stepper-number">1</span>
        <span class="stepper-label">Connect</span>
      </button>
      <button class="stepper-item" type="button" data-step-target="import">
        <span class="stepper-number">2</span>
        <span class="stepper-label">Import</span>
      </button>
      <button class="stepper-item" type="button" data-step-target="mode">
        <span class="stepper-number">3</span>
        <span class="stepper-label">Mode</span>
      </button>
      <button class="stepper-item" type="button" data-step-target="compare">
        <span class="stepper-number">4</span>
        <span class="stepper-label">Compare</span>
      </button>
      <button class="stepper-item" type="button" data-step-target="results">
        <span class="stepper-number">5</span>
        <span class="stepper-label">Results</span>
      </button>
    </nav>
    <p class="text-xs text-latte-subtext0" data-stepper-status role="status" aria-live="polite"></p>
  </section>

  <section class="card rank-loading" data-rank-loading>
    <div class="pill mb-3">Session setup</div>
    <h3 class="text-xl font-display">Moonsorter loads the ranking tools.</h3>
    <p class="text-sm text-latte-subtext1">
      Moonsorter reads your saved progress and prepares the session.
    </p>
    <div class="loading-bar mt-4"></div>
  </section>

  <section class="card hidden" data-step="connect">
    <div class="pill mb-3">Step 1: Connect</div>
    <h3 class="text-xl font-display">Connect your source</h3>
    <p class="text-sm text-latte-subtext1 mb-4">
      Connect to AniList to import your list and to upload your scores. You can also use a CSV file or the demo list.
    </p>
    <div class="flex flex-wrap gap-3">
      <button class="btn btn-anilist" type="button" data-action="connect">
        <svg class="h-5 w-5" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="512" height="512" fill="#1e2630"/>
          <path d="M321.92 323.27V136.6c0-10.698-5.887-16.602-16.558-16.602h-36.433c-10.672 0-16.561 5.904-16.561 16.602v88.651c0 2.497 23.996 14.089 24.623 16.541 18.282 71.61 3.972 128.92-13.359 131.6 28.337 1.405 31.455 15.064 10.348 5.731 3.229-38.209 15.828-38.134 52.049-1.406.31.317 7.427 15.282 7.87 15.282h85.545c10.672 0 16.558-5.9 16.558-16.6v-36.524c0-10.698-5.886-16.602-16.558-16.602z" fill="#02a9ff"/>
          <path d="M170.68 120 74.999 393h74.338l16.192-47.222h80.96L262.315 393h73.968l-95.314-273zm11.776 165.28 23.183-75.629 25.393 75.629z" fill="#fefefe"/>
        </svg>
        <span>Connect to AniList</span>
      </button>
      <button class="btn-secondary" type="button" data-action="csv">
        Use a CSV file
      </button>
      <button class="btn-secondary" type="button" data-action="demo">
        Use the demo list
      </button>
    </div>
    <p class="text-xs text-latte-subtext0" data-connect-status role="status" aria-live="polite"></p>
  </section>

  <section class="card hidden" data-step="import">
    <div class="pill mb-3">Step 2: Import</div>
    <h3 class="text-xl font-display" data-import-title>Import your list</h3>
    <p class="text-sm text-latte-subtext1 mb-4" data-import-desc>
      Import your titles from AniList, or import a CSV file. Then select how many titles to rank now.
    </p>
    <!-- A plain grid, not a form: these controls are read by the import
         buttons below and there is nothing to submit. As a <form> it had no
         action, so an implicit submission would GET-navigate to `?` and wipe
         the session; only the field count was suppressing that. -->
    <div class="grid gap-4 md:grid-cols-2">
      <!-- CSV-only: file input -->
      <label class="col-span-full" data-import-path="csv">
        CSV file with the columns title, score, and media_id (media_id is optional)
        <input id="csv-file" type="file" accept=".csv,text/csv" />
      </label>

      <!-- AniList-only fields -->
      <label class="col-span-full" data-import-path="anilist">
        Media type
        <select id="media-type">
          <option value="ANIME">Anime</option>
          <option value="MANGA">Manga</option>
        </select>
      </label>
      <label data-import-path="anilist">
        Import mode
        <select id="import-mode">
          <option value="all">All completed and current titles</option>
          <option value="top">Top slice only</option>
          <option value="bottom">Bottom slice only</option>
          <option value="top-bottom">Top and bottom slice</option>
        </select>
      </label>
      <label data-import-path="anilist">
        Slice size (for the top and bottom modes)
        <input id="import-count" type="number" min="5" max="100" value="20" />
      </label>
      <label class="flex items-center gap-2 text-sm text-latte-subtext1" data-import-path="anilist">
        <input id="include-unscored" type="checkbox" />
        <span>Include the unscored titles</span>
      </label>
      <label class="flex items-center gap-2 text-sm text-latte-subtext1">
        <input id="use-score-prior" type="checkbox" checked />
        <span>Use the original scores as priors</span>
      </label>
      <label class="flex items-center gap-2 text-sm text-latte-subtext1" data-import-path="anilist">
        <input id="preserve-range" type="checkbox" checked />
        <span>Keep the original score range on upload</span>
      </label>
      <label data-import-path="anilist">
        Score scale
        <select id="score-format">
          <option value="AUTO">Use the AniList format (automatic)</option>
          <option value="POINT_100">100-point</option>
          <option value="POINT_10_DECIMAL">10-point (decimal)</option>
          <option value="POINT_10">10-point</option>
          <option value="POINT_5">5-point</option>
          <option value="POINT_3">3-point</option>
        </select>
      </label>

      <!-- AniList-only: year filters -->
      <label data-import-path="anilist">
        Aired year (from and to)
        <div class="mt-2 grid grid-cols-2 gap-2">
          <input id="filter-aired-from" type="number" min="1900" step="1" />
          <input id="filter-aired-to" type="number" min="1900" step="1" />
        </div>
      </label>
      <label data-import-path="anilist">
        Started year (from and to)
        <div class="mt-2 grid grid-cols-2 gap-2">
          <input id="filter-started-from" type="number" min="1900" step="1" />
          <input id="filter-started-to" type="number" min="1900" step="1" />
        </div>
      </label>
      <label data-import-path="anilist">
        Completed year (from and to)
        <div class="mt-2 grid grid-cols-2 gap-2">
          <input id="filter-completed-from" type="number" min="1900" step="1" />
          <input id="filter-completed-to" type="number" min="1900" step="1" />
        </div>
      </label>
      <label data-import-path="anilist">
        List updated year (from and to)
        <div class="mt-2 grid grid-cols-2 gap-2">
          <input id="filter-updated-from" type="number" min="1900" step="1" />
          <input id="filter-updated-to" type="number" min="1900" step="1" />
        </div>
      </label>

      <!-- Advanced options (collapsed) -->
      <details class="col-span-full">
        <summary class="cursor-pointer text-sm font-semibold text-latte-subtext0 hover:text-latte-text">
          Advanced options
        </summary>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <label>
            <span class="inline-flex items-center gap-2">
              Exploration rate (epsilon)
              <span class="help-dot" title="This value sets how frequently Moonsorter asks a random comparison instead of the most informative pair.">?</span>
            </span>
            <input
              id="exploration-epsilon"
              type="number"
              min="0"
              max="1"
              step="0.01"
              value="0.1"
            />
          </label>
          <label>
            <span class="inline-flex items-center gap-2">
              Uncertainty prior
              <span class="help-dot" title="This value regularizes the uncertainty scores. A high value makes the pair selection less sensitive to sparse data.">?</span>
            </span>
            <input id="uncertainty-prior" type="number" min="0.1" step="0.1" value="1" />
          </label>
        </div>
      </details>
    </div>
    <div class="mt-4 flex flex-wrap gap-3">
      <button class="btn" type="button" data-action="import" data-import-path="anilist">
        Import from AniList
      </button>
      <button class="btn" type="button" data-action="import-csv" data-import-path="csv">
        Import from CSV
      </button>
      <button class="btn-secondary" type="button" data-action="logout" data-import-path="anilist">
        Disconnect
      </button>
      <button class="btn-secondary" type="button" data-action="back-to-connect">
        Back
      </button>
    </div>
    <p class="text-xs text-latte-subtext0 mt-3" data-import-status role="status" aria-live="polite"></p>
  </section>

  <section class="card hidden" data-step="mode">
    <div class="pill mb-3">Step 3: Select mode</div>
    <h3 class="text-xl font-display">Select how you want to rank</h3>
    <p class="text-sm text-latte-subtext1 mb-4">
      This selection changes only the interaction style. The model stays the same.
    </p>
    <div class="space-y-4">
      <div class="card-muted space-y-3">
        <div class="pill">Rescore an existing list</div>
        <p class="text-sm text-latte-subtext1">
          These modes keep your current order.
          They change only the titles that are in the wrong position.
        </p>
        <div class="grid gap-3 md:grid-cols-2">
          <button
            class="mode-card"
            type="button"
            data-rank-goal="rescore"
            data-rank-mode="pairwise"
          >
            <span class="font-semibold text-latte-text">Pairwise only</span>
            <span class="text-xs text-latte-subtext0">
              Moonsorter uses A/B comparisons with strong priors from your scores.
            </span>
          </button>
          <button
            class="mode-card"
            type="button"
            data-rank-goal="rescore"
            data-rank-mode="group"
          >
            <span class="font-semibold text-latte-text">Group sort only</span>
            <span class="text-xs text-latte-subtext0">
              Drag small batches into order.
              This mode is good when you must change many positions.
            </span>
          </button>
        </div>
      </div>
      <div class="card-muted space-y-3">
        <div class="pill">Rank from scratch</div>
        <p class="text-sm text-latte-subtext1">
          These modes build a new order. They ignore your prior scores.
        </p>
        <label class="text-sm text-latte-subtext1">
          Goal
          <select id="scratch-goal">
            <option value="full">Rank all the titles</option>
            <option value="top-k">Find the top tier quickly</option>
          </select>
        </label>
        <div class="grid gap-3 md:grid-cols-3">
          <button
            class="mode-card"
            type="button"
            data-rank-goal="scratch"
            data-rank-mode="pairwise"
          >
            <span class="font-semibold text-latte-text">Pairwise only</span>
            <span class="text-xs text-latte-subtext0">
              Moonsorter uses A/B comparisons for the full list. This mode is slow and steady.
            </span>
          </button>
          <button
            class="mode-card"
            type="button"
            data-rank-goal="scratch"
            data-rank-mode="group"
          >
            <span class="font-semibold text-latte-text">Group sort only</span>
            <span class="text-xs text-latte-subtext0">
              Moonsorter builds the order from group sorts. This mode is faster.
            </span>
          </button>
          <button
            class="mode-card"
            type="button"
            data-rank-goal="scratch"
            data-rank-mode="group-pairwise"
          >
            <span class="font-semibold text-latte-text">
              Group sort → Pairwise refine
            </span>
            <span class="text-xs text-latte-subtext0">
              Moonsorter starts with group sorts. Then you refine the order with A/B comparisons.
            </span>
          </button>
        </div>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-3">
      <button class="btn-secondary" type="button" data-action="back-to-import">
        Back to import
      </button>
    </div>
  </section>

  <Comparison />
  <SortGroup />

  <section class="hidden compare-actions-bar" data-step="compare-actions">
    <div class="compare-actions-left">
      <button class="btn-secondary btn-with-kbd" type="button" data-action="undo">
        <span>Undo</span><span class="kbd-badge kbd-hint">U</span>
      </button>
      <button class="btn-secondary btn-with-kbd" type="button" data-action="redo" disabled>
        <span>Redo</span><span class="kbd-badge kbd-hint">^Y</span>
      </button>
      <button class="btn" type="button" data-action="finish">
        Finish and review
      </button>
      <label class="inline-tier-toggle">
        <input id="opt-in-tier-list" type="checkbox" checked />
        <span>Generate tier list</span>
      </label>
    </div>
    <div class="compare-actions-right kbd-hint">
      <span class="kbd-ref"><span class="kbd-badge">A</span>/<span class="kbd-badge">←</span> left</span>
      <span class="kbd-ref"><span class="kbd-badge">B</span>/<span class="kbd-badge">→</span> right</span>
      <span class="kbd-ref"><span class="kbd-badge">␣</span> tie</span>
    </div>
  </section>

  <!-- Early finish warning modal -->
  <div
    class="modal-overlay hidden"
    data-early-finish-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="early-finish-title"
    aria-describedby="early-finish-message"
  >
    <div class="modal-card">
      <h3 class="text-lg font-display mb-2" id="early-finish-title">Results can be unreliable</h3>
      <p class="text-sm text-latte-subtext1 mb-4" id="early-finish-message" data-early-finish-message>
        <!-- Message will be filled by JS -->
      </p>
      <div class="flex gap-3">
        <button class="btn-secondary" type="button" data-action="cancel-finish">
          Continue the comparisons
        </button>
        <button class="btn" type="button" data-action="confirm-finish">
          Show the results
        </button>
      </div>
    </div>
  </div>

  <!-- Start over confirmation modal -->
  <div
    class="modal-overlay hidden"
    data-start-over-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="start-over-title"
    aria-describedby="start-over-message"
  >
    <div class="modal-card">
      <h3 class="text-lg font-display mb-2" id="start-over-title">Start again?</h3>
      <p class="text-sm text-latte-subtext1 mb-4" id="start-over-message">
        This action will clear all comparisons and rankings. You cannot undo this action.
      </p>
      <div class="flex gap-3">
        <button class="btn-secondary" type="button" data-action="cancel-start-over">
          Cancel
        </button>
        <button class="btn" type="button" data-action="confirm-start-over">
          Start again
        </button>
      </div>
    </div>
  </div>

  <Rankings />
  <TierList />

  <script>
    import '../app/rank.ts';
  </script>
</Layout>
