---
import '../styles/global.css';

import { withBase } from '../lib/utils';

const {
  title = 'Moonsorter',
  description = 'Moonsorter ranks your AniList list with pairwise comparisons. It uses MoonBit and WebAssembly.',
  // Pages that never load `rank.ts` have nothing for these buttons to switch
  // between, and an inert control reads as a broken one.
  views = true,
} = Astro.props;

// One normalised source of truth. Pages used to thread a raw `data-base-url`
// prop in, which is how an unnormalised base reached two href templates.
const baseUrl = withBase();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      Production only: `astro dev` serves its HMR client as an inline script,
      which `script-src 'self'` blocks — that breaks hot reload and teaches you
      to ignore console CSP errors. The shipped build emits zero inline
      <script>, so the policy costs nothing there.

      Must stay directly after <meta charset>: a meta CSP only governs
      resources the parser reaches after it. GitHub Pages cannot set headers,
      so this is the only delivery mechanism available; `frame-ancestors`,
      `report-uri` and `sandbox` are header-only and are silently ignored here.

      'wasm-unsafe-eval' is required or WebAssembly.instantiate is blocked,
      which would take the ranker with it. style-src needs 'unsafe-inline' for
      Astro's scoped <style> block; hashing it would silently break the page on
      any style edit.
    */}
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self';
                 script-src 'self' 'wasm-unsafe-eval';
                 style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
                 font-src https://fonts.gstatic.com;
                 img-src 'self' data: blob: https://*.anilist.co;
                 connect-src 'self' https://graphql.anilist.co;
                 object-src 'none';
                 base-uri 'none';
                 form-action 'none'"
      />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-base-url={baseUrl}>
    <div class="app-shell">
      {/*
        The top bar replaces the five-step stepper. Which view is open implies
        where you are in the flow, so the buttons carry `aria-current="page"`
        rather than inventing tab semantics for panels that are not tabpanels.
      */}
      <header class="topbar">
        <a href={baseUrl} class="topbar-brand">
          <span class="topbar-mark" aria-hidden="true"></span>
          <span class="topbar-name">Moonsorter</span>
          <span class="topbar-session" data-session-label></span>
        </a>
        {views && (
          <nav class="topbar-nav" aria-label="Views">
            <button class="nav-link" type="button" data-view-target="list">List</button>
            <button class="nav-link" type="button" data-view-target="compare">Compare</button>
            <button class="nav-link" type="button" data-view-target="results">Results</button>
          </nav>
        )}
      </header>
      <slot />
    </div>
  </body>
</html>
