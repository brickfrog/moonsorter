---
import '../styles/global.css';

const {
  title = 'Moonsorter',
  description = 'Pairwise ranking for AniList via MoonBit and WASM.',
  'data-base-url': dataBaseUrl = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      Production only: `astro dev` serves its HMR client as an inline script,
      which `script-src 'self'` blocks — that breaks hot reload and teaches you
      to ignore console CSP errors. The shipped build emits zero inline
      <script>, so the policy costs nothing there.

      Must stay directly after <meta charset>: a meta CSP only governs
      resources the parser reaches after it. GitHub Pages cannot set headers,
      so this is the only delivery mechanism available; `frame-ancestors`,
      `report-uri` and `sandbox` are header-only and are silently ignored here.

      'wasm-unsafe-eval' is required or WebAssembly.instantiate is blocked,
      which would take the ranker with it. style-src needs 'unsafe-inline' for
      Astro's scoped <style> block; hashing it would silently break the page on
      any style edit.
    */}
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self';
                 script-src 'self' 'wasm-unsafe-eval';
                 style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
                 font-src https://fonts.gstatic.com;
                 img-src 'self' data: blob: https://*.anilist.co;
                 connect-src 'self' https://graphql.anilist.co;
                 object-src 'none';
                 base-uri 'none';
                 form-action 'none'"
      />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${dataBaseUrl}favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloock&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-base-url={dataBaseUrl}>
    <div class="site-container">
      <header class="flex flex-col gap-6 pb-8 pt-8 md:flex-row md:items-center md:justify-between">
        <a href={dataBaseUrl || '/'} class="flex items-center gap-4">
          <div class="moon-mark" aria-hidden="true"></div>
          <h1 class="font-display text-4xl md:text-5xl">Moonsorter</h1>
        </a>
        <nav class="flex flex-wrap items-center gap-2">
          <a class="nav-link" href="https://github.com/brickfrog/moonsorter" rel="noopener">GitHub</a>
        </nav>
      </header>
      <main class="flex flex-col gap-16">
        <slot />
      </main>
      <footer class="site-footer">
        <span>Built with MoonBit + WASM.</span>
        <a href="https://github.com/brickfrog/moonsorter" rel="noopener">source</a>
      </footer>
    </div>
  </body>
</html>
