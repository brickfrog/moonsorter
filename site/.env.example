# AniList OAuth Client ID (get from https://anilist.co/settings/developer)
PUBLIC_ANILIST_CLIENT_ID=

# OAuth flow. Defaults to 'token' (implicit grant), which is the only flow a
# static build can complete. Set 'code' only if you add a server adapter and a
# /api/anilist/token route that can hold the client secret.
PUBLIC_ANILIST_RESPONSE_TYPE=token

# The redirect URI is not sent in the authorize request; AniList uses the one
# registered for the client. Register https://<your-host>/<base>callback there.
