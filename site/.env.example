# The AniList OAuth client ID.
# Get this ID from https://anilist.co/settings/developer
PUBLIC_ANILIST_CLIENT_ID=

# The OAuth flow. The default is 'token', the implicit grant. A static build
# can complete this flow only. If you add a server adapter and an
# /api/anilist/token route that holds the client secret, set this value to
# 'code'.
PUBLIC_ANILIST_RESPONSE_TYPE=token

# Moonsorter does not send the redirect URI in the authorize request. AniList
# uses the URI that you register for the client. Register the URI
# https://<your-host>/<base>callback on the AniList developer page.
